# Node 24+. Native variables are loaded directly, with no per-variable Compose mapping.
BACKUP_HOST=127.0.0.1
BACKUP_PORT=16323
BACKUP_PUBLIC_URL=http://127.0.0.1:16323
DATA_DIR=.data
# Separate multiple roots with the OS path delimiter (; on Windows, : on Linux).
SOURCE_ROOTS=./sources
# Required for initial account setup when binding outside loopback.
SETUP_TOKEN=
# Optional initial admin provisioning. Never commit the actual .env file.
ADMIN_USERNAME=
ADMIN_PASSWORD=
# Existing rclone config is imported into a private writable persistent copy.
RCLONE_CONFIG_SOURCE=
RCLONE_BINARY=rclone
SEVEN_ZIP_BINARY=7zz
PG_DUMP_BINARY=pg_dump
MYSQL_DUMP_BINARY=mariadb-dump

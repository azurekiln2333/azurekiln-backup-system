# Prebuilt image used by compose.yaml. Override with a CNB image path, a version
# tag (for example :0.1.0), or a digest (name@sha256:...).
BACKUP_IMAGE=ghcr.io/azurekiln2333/azurekiln-backup-system:latest
# Seconds between automatic update checks. Default is 600 (10 minutes).
WATCHTOWER_POLL_INTERVAL=600
# Compose project name. It also scopes automatic updates: only containers of this
# deployment are updated, so each deployment needs a distinct value. Leave empty
# to let Compose derive it from the project directory name.
COMPOSE_PROJECT_NAME=

BACKUP_HOST=0.0.0.0
BACKUP_PORT=16323
BACKUP_PUBLIC_URL=http://127.0.0.1:16323
DATA_DIR=/data
SOURCE_ROOTS=/sources
# Choose a private random token for initial setup; change the public URL for HTTPS deployment.
SETUP_TOKEN=
ADMIN_USERNAME=
ADMIN_PASSWORD=
RCLONE_CONFIG_DIR=/root/.config/rclone
RCLONE_CONFIG_SOURCE=/config/rclone.conf
RCLONE_BINARY=rclone
SEVEN_ZIP_BINARY=7zz
PG_DUMP_BINARY=pg_dump
MYSQL_DUMP_BINARY=mariadb-dump
